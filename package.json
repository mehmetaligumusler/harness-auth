{
  "name": "harness-auth",
  "version": "1.0.0",
  "description": "HarnessAuth — Desktop AI harness session manager",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir desktop tauri dev",
    "build:sidecar": "node desktop/scripts/prepare-sidecar.mjs",
    "build:frontend": "pnpm --dir desktop build",
    "build:installer": "node desktop/scripts/prepare-sidecar.mjs && pnpm --dir desktop tauri build",
    "test:engine": "bun test",
    "test": "bun test && pnpm --dir desktop build",
    "regen:mcp": "bun run scripts/regen-mcp-catalogue.ts"
  },
  "dependencies": {
    "happy-dom": "^20.11.6",
    "undici": "^8.10.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
